{
  "expo": {
    "name": "bulletin.",
    "slug": "Bulletin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bulletin-icon.png",
    "scheme": "bulletin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bulletin-icon.png",
      "bundleIdentifier": "com.nmakranyi.Bulletin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bulletin-android-foreground.png",
        "monochromeImage": "./assets/images/bulletin-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bulletin-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is only used to help you drop a pin on the map, and it is never shared."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c62aec79-f661-434f-96ad-a689605fa747"
      }
    }
  }
}
